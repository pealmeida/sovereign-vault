# Python
__pycache__/
*.pyc

# LaTeX build artifacts (docs/thesis/). The thesis source is paper.tex; the
# compiled PDF and auxiliary files are reproducible and must not be versioned.
# Exception: docs/thesis/oliveira-2026-*.pdf is the submitted paper, kept on
# purpose and already tracked.
docs/thesis/paper.pdf
docs/thesis/*.aux
docs/thesis/*.out
docs/thesis/*.toc
docs/thesis/*.lof
docs/thesis/*.lot
docs/thesis/*.bbl
docs/thesis/*.blg
docs/thesis/*.brf
docs/thesis/*.synctex.gz

# USPSC variant build artifacts
docs/thesis/paper-uspsc.pdf
docs/thesis/paper-uspsc.aux
docs/thesis/paper-uspsc.toc
docs/thesis/paper-uspsc.lof
docs/thesis/paper-uspsc.lot
docs/thesis/paper-uspsc.out

# Derived from paper.tex by scripts/sync-uspsc-body.py — never edit or commit
docs/thesis/uspsc/_body.tex
docs/thesis/uspsc/_pretextual-conteudo.tex

# Private thesis working notes — maintained outside the public repository
docs/thesis/orientacao/FICHA-CATALOGRAFICA-DADOS.md
docs/thesis/orientacao/PERFIL-ORIENTADORA.md
docs/thesis/orientacao/PUBLICACOES-KALINKA-LINKS.md
