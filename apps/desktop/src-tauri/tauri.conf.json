{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sovereign Vault",
  "version": "0.0.0",
  "identifier": "com.sovereign-vault.app",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Sovereign Vault",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local-first encrypted vault for AI agents",
    "longDescription": "Sovereign Vault is a local-first encrypted file vault for AI agents. Agents request access via the Model Context Protocol; users approve or deny each access. All accesses are audited."
  }
}
